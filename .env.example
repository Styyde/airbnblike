# Configure these variables in the shell before starting Spring Boot.
# Spring Boot does not load this file automatically.
MONGODB_URI=mongodb://localhost:27018/airbnb_clone?replicaSet=rs0&directConnection=true
PORT=8082
JWT_SECRET=replace-with-a-random-secret-containing-at-least-64-bytes
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Demo only; no real money is charged. The default is disabled.
PAYMENT_MODE=demo
# Local image storage; do not commit uploaded files.
UPLOAD_DIR=./data/uploads
